# Remote Ollama host: use its Tailscale IPv4 address or MagicDNS hostname.
OLLAMA_BASE_URL=http://100.101.102.103:11434
APP_PORT=8080
OLLAMA_READ_TIMEOUT=180
# Retain the last-used model in host memory longer between requests.
OLLAMA_KEEP_ALIVE=10m
# concise: direct answers and code-only code responses; model_default: no style instruction.
CHAT_RESPONSE_STYLE=concise
# Saved scripts run in a separate, network-disabled container. Also enable access in the chat/profile.
SCRIPT_TOOLS_ENABLED=true
SCRIPT_TIMEOUT_SECONDS=30
SCRIPT_OUTPUT_BYTES=32768
SCRIPT_MAX_CALLS=4
